# Variables de entorno. Copia este archivo a backend/.env y llena los valores.
# NUNCA subas el .env real a git.

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lyra
REDIS_URL=redis://localhost:6379

# Whisper (voz a texto) y LLM
OPENAI_API_KEY=
# Si usas Claude como LLM:
ANTHROPIC_API_KEY=
MODELO_LLM=

# TTS (elige un proveedor)
PROVEEDOR_TTS=elevenlabs
ELEVENLABS_API_KEY=
ID_VOZ=
VELOCIDAD_VOZ=0.9

# Picovoice Porcupine (palabra clave "Lyra"); el frontend la necesita como VITE_
PORCUPINE_ACCESS_KEY=

# Web Push (genera con: uv run python -c "from py_vapid import Vapid; ...")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:tu-correo@ejemplo.com
