# Copia este archivo a backend/.env y llena los valores.
# Base de datos. Para probar sin instalar Postgres puedes usar SQLite:
#   DATABASE_URL=sqlite+aiosqlite:///./lyra.db
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lyra

# Voz (TTS). Si lo dejas vacio, Lyra usa la voz del navegador temporalmente.
# Opciones: openai | elevenlabs
PROVEEDOR_TTS=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# openai: nombre de la voz (ej. coral). elevenlabs: el voice_id.
ID_VOZ=
# Opcional: modelo del TTS (openai: gpt-4o-mini-tts; elevenlabs: eleven_flash_v2_5)
MODELO_TTS=
# Solo elevenlabs (0.7 a 1.2)
VELOCIDAD_VOZ=0.9
